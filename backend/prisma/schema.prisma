generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id        String               @id @default(uuid()) @db.Char(36)
  name      String               @db.VarChar(120)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  owner     User?
  products  Product[]
  settings  OrganizationSettings?
}

model User {
  id             String       @id @default(uuid()) @db.Char(36)
  email          String       @unique @db.VarChar(254)
  passwordHash   String       @db.VarChar(255)
  organizationId String       @unique @db.Char(36)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedProducts Product[]   @relation("ProductUpdatedBy")
}

model Product {
  id                String       @id @default(uuid()) @db.Char(36)
  organizationId    String       @db.Char(36)
  name              String       @db.VarChar(160)
  sku               String       @db.VarChar(80)
  description       String?      @db.Text
  quantityOnHand    Int          @default(0)
  costPrice         Decimal?     @db.Decimal(12, 2)
  sellingPrice      Decimal?     @db.Decimal(12, 2)
  lowStockThreshold Int?
  lastUpdatedBy            String?      @db.Char(36)
  lastStockAdjustmentNote  String?      @db.VarChar(500)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy                User?        @relation("ProductUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([lastUpdatedBy])
}

model OrganizationSettings {
  id                        String       @id @default(uuid()) @db.Char(36)
  organizationId            String       @unique @db.Char(36)
  defaultLowStockThreshold  Int          @default(5)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
